# ─────────────────────────────────────────────────────────────
#  AI Trading Platform — environment configuration
#  Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- App ---
APP_ENV=development                 # development | production
APP_NAME="AI Trading Platform"
API_PORT=8000

# --- Security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key used to encrypt broker API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-fernet-key

# --- Database (PostgreSQL) ---
# Works with any Postgres. Use the async driver (asyncpg).
#
# Local docker-compose default:
DATABASE_URL=postgresql+asyncpg://trading:trading@db:5432/trading
#
# Supabase project "ai-trading-platform" (eu-central-1) — paste your DB password:
#   Direct:  postgresql+asyncpg://postgres:[PASSWORD]@db.cddgxnbyhkrhehilitzz.supabase.co:5432/postgres
#   Pooler:  postgresql+asyncpg://postgres.cddgxnbyhkrhehilitzz:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://cddgxnbyhkrhehilitzz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_4Z2q8FEWyQxF42yeXaVCWw_I9eBzCzN

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Broker ---
# paper | capital_com   (paper is the safe default)
BROKER=paper
CAPITAL_COM_API_KEY=
CAPITAL_COM_IDENTIFIER=
CAPITAL_COM_PASSWORD=
CAPITAL_COM_DEMO=true               # use Capital.com demo environment

# --- TradingView webhook ---
TRADINGVIEW_WEBHOOK_SECRET=change-me

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News/sentiment (optional) — free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# --- Autopilot cron secret (lets an external cron drive the trading cycle) ---
CRON_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
